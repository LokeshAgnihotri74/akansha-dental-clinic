# Server Configuration
PORT=8080
NODE_ENV=development

# Real Managed Database Configuration (PostgreSQL / MySQL)
# Set DATABASE_URL for Render PostgreSQL, Neon, Supabase, Aiven, or Railway:
# DATABASE_URL=postgresql://user:password@host:5432/akansha_dental_db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=akansha_dental_db

# Security & Authentication (Required: minimum 32 characters)
JWT_SECRET=generate_a_random_32_plus_character_secure_secret_key_here
JWT_EXPIRES_IN=24h

# Initial Super Admin Provisioning (Used on first initialization if database/store is empty)
ADMIN_INITIAL_EMAIL=admin@akanshadental.com
ADMIN_INITIAL_PASSWORD=your_strong_admin_password_here

# Clinic Operational Defaults
CLINIC_NAME="Akansha Dental Clinic & Implant Center"
CLINIC_PHONE="+91 8130 406 405"
CLINIC_EMAIL="support@akanshadental.com"

# Email / SMTP Configuration (Nodemailer for sending real patient emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM_NAME="Akansha Dental Clinic & Implant Center"
SMTP_FROM_EMAIL="support@akanshadental.com"

# SMS / WhatsApp Gateway (Optional: Fast2SMS, MSG91, or Twilio)
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
